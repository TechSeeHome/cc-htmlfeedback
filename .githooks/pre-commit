#!/usr/bin/env bash
# Pre-commit hook: format and lint staged files before allowing a commit.
#
# Only operates on staged files (not the whole repo), so it stays fast.
# Enable with: git config core.hooksPath .githooks
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# Collect staged, added/copied/modified files (skip deletions).
staged_files=()
while IFS= read -r file; do
  [ -n "$file" ] && staged_files+=("$file")
done < <(git diff --cached --name-only --diff-filter=ACM)

if [ "${#staged_files[@]}" -eq 0 ]; then
  exit 0
fi

status=0

# --- Prettier check --------------------------------------------------------
# Extensions match what this repo already formats with Prettier (see
# .prettierrc.json). Prettier itself still applies .prettierignore even to
# explicitly-listed files, so we only need to pre-filter by extension here to
# decide whether it's worth invoking prettier at all.
prettier_files=()
for file in "${staged_files[@]}"; do
  case "$file" in
    *.js | *.mjs | *.cjs | *.jsx | *.ts | *.tsx | *.json | *.md | *.mdx | *.html | *.css | *.scss | *.less | *.yml | *.yaml)
      prettier_files+=("$file")
      ;;
  esac
done

if [ "${#prettier_files[@]}" -eq 0 ]; then
  echo "pre-commit: no staged files for prettier to check, skipping."
else
  echo "pre-commit: running prettier --check on ${#prettier_files[@]} staged file(s)..."
  if ! npx --no-install prettier --check --ignore-unknown "${prettier_files[@]}"; then
    echo ""
    echo "pre-commit: prettier check FAILED on the file(s) listed above."
    echo "Fix with: npx prettier --write <file...> on the failing files, then re-stage and commit again."
    status=1
  fi
fi

# --- oxlint check (staged designhub JS only) -------------------------------
designhub_js_files=()
for file in "${staged_files[@]}"; do
  case "$file" in
    designhub/*.js)
      designhub_js_files+=("$file")
      ;;
  esac
done

if [ "${#designhub_js_files[@]}" -eq 0 ]; then
  echo "pre-commit: no staged designhub/*.js files for oxlint to check, skipping."
else
  echo "pre-commit: running oxlint on ${#designhub_js_files[@]} staged designhub js file(s)..."
  if ! npx --no-install oxlint "${designhub_js_files[@]}"; then
    echo ""
    echo "pre-commit: oxlint reported errors in the designhub file(s) listed above."
    echo "Fix the errors, then re-stage and commit again."
    status=1
  fi
fi

if [ "$status" -ne 0 ]; then
  echo ""
  echo "pre-commit: commit blocked, see failures above."
fi

exit "$status"
